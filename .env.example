# BizIntel Environment Configuration
#
# DOCKER DEPLOYMENT:
# Every value below is OPTIONAL when running with Docker Compose (`docker compose up`).
# - BIZINTEL_SESSION_SECRET is auto-generated and stored in /app/data/.session_secret if not provided.
# - BIZINTEL_COOKIE_SECURE defaults to false for local http://localhost:8080 access.
# - DB_URL defaults to sqlite:////app/data/biz_intelligence.db within the container volume.
# - LLM_MODEL defaults to gemma3:4b.
# - OLLAMA_BASE_URL defaults to http://ollama:11434 (internal Docker network).
#
# RUNNING WITHOUT DOCKER (LOCAL / DIRECT):
# Copy this file to .env and adjust values if needed.

# (Optional for Docker) Secret key for signing session cookies.
# If unset in Docker, an auto-generated 48-byte key is stored in /app/data/.session_secret.
BIZINTEL_SESSION_SECRET=replace-with-a-long-random-secret

# (Optional for Docker) Cookie security flag.
# Set to false for local HTTP development (e.g. localhost:8080 or localhost:5173).
# Set to true only behind HTTPS. Default in Docker: false.
BIZINTEL_COOKIE_SECURE=false

# (Optional for Docker) Database connection URL.
# SQLite database path. Default in Docker: sqlite:////app/data/biz_intelligence.db
DB_URL=sqlite:///data/biz_intelligence.db

# (Optional for Docker) Local AI model to use via Ollama.
# Default in Docker: gemma3:4b
LLM_MODEL=gemma3:4b

# (Optional for Docker) Ollama API endpoint.
# Local default: http://localhost:11434. Docker internal default: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
