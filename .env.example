# Copy this file to .env, then replace the example session secret.
# Use a long, random value. Never commit your real .env file.
BIZINTEL_SESSION_SECRET=replace-with-a-long-random-secret

# Set to true when running behind HTTPS in production; false for local http://localhost dev
BIZINTEL_COOKIE_SECURE=false

# Database and local AI defaults. Change these only if your setup differs.
DB_URL=sqlite:///data/biz_intelligence.db
LLM_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
